{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sales",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sales-db",
      "database_id": "b16adaac-a335-476e-b452-417971bc44f0",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_URL": "https://shekvetebi.pages.dev"
  },
  "triggers": {
    "crons": [
      "*/5 8 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
