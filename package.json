{
  "name": "dedas-orders",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8791 --test-scheduled",
    "db:local": "wrangler d1 migrations apply DB --local",
    "build": "wrangler deploy --dry-run --outdir build",
    "deploy": "node scripts/deploy.mjs",
    "test": "node --test tests/core.test.mjs",
    "test:ui": "playwright test",
    "deploy:ci": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "wrangler": "4.149.0"
  }
}
